    "plugininitlogs": [
      "[codinglite] boot v1.0.4",
      "[codinglite] bridge: Hyflox.fs, Hyflox.notify, Hyflox.htaWarn",
      "[codinglite] workspace mounted",
      "[codinglite] live-preview engine online (debounced 350ms)",
      "[codinglite] parsers: js, ts, py, c, cpp, go, rs, html, css, json, md, txt",
