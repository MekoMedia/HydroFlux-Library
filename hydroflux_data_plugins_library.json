    ],
    "pluginscript": [
      "<!DOCTYPE html><html><head><meta charset='utf-8'><style>",
      "*{box-sizing:border-box;margin:0;padding:0}",
      "html,body{height:100%;overflow:hidden;font:12px Consolas,'Courier New',monospace;background:#1e1e1e;color:#d4d4d4}",
      "input,textarea,select{user-select:text!important;-webkit-user-select:text!important}",
      ".app{display:flex;flex-direction:column;height:100%}",
      ".top{display:flex;align-items:center;gap:4px;padding:4px 8px;background:#252526;border-bottom:1px solid #333;flex:none;flex-wrap:wrap}",
      ".top button{background:transparent;border:0;color:#ccc;padding:3px 10px;font-size:11px;cursor:pointer;border-radius:2px}",
      ".top button:hover{background:#3a3a3a}",
      ".top button.run{background:#0e639c;color:#fff}",
      ".top button.run:hover{background:#1177bb}",
      ".top button.stop{background:#7a1f1f;color:#fff}",
      ".top button.stop:hover{background:#a02626}",
      ".top button.live-btn{background:#2a4a2a;color:#9ee89e}",
      ".top button.live-btn.on{background:#107c10;color:#fff}",
      ".top select{background:#3c3c3c;color:#fff;border:1px solid #555;padding:2px 6px;font-size:11px}",
      ".body{display:flex;flex:1;min-height:0}",
      ".side{width:180px;background:#252526;border-right:1px solid #333;overflow-y:auto;padding:4px;font-size:11px;flex:none}",
      ".side .grp{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:#888;padding:6px 6px 2px;font-weight:600}",
      ".side .it{padding:4px 8px;cursor:pointer;border-radius:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}",
      ".side .it:hover{background:#2a2d2e}",
      ".main{flex:1;display:flex;flex-direction:column;min-width:0}",
      ".tabs{display:flex;background:#252526;border-bottom:1px solid #333;overflow-x:auto;flex:none}",
      ".tab{padding:5px 12px;font-size:11px;background:#2d2d2d;border-right:1px solid #333;color:#969696;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:4px}",
      ".tab.on{background:#1e1e1e;color:#fff;border-top:1px solid #0e639c}",
      ".tab .x{opacity:.6;font-size:10px}",
      ".tab .x:hover{opacity:1;color:#fff}",
      ".ed{flex:1;display:flex;min-height:0;position:relative}",
      ".gt{width:44px;padding:8px 4px;text-align:right;color:#555;overflow:hidden;font:12.5px/1.5 Consolas,'Courier New',monospace;user-select:none;background:#1e1e1e;flex:none;white-space:pre;tab-size:2;letter-spacing:normal;font-variant-ligatures:none}",
      ".wrap{flex:1;position:relative;min-width:0;overflow:hidden}",
      ".hl,.code{font:12.5px/1.5 Consolas,'Courier New',monospace;padding:8px 12px;white-space:pre;box-sizing:border-box;tab-size:2;letter-spacing:normal;word-spacing:normal;font-variant-ligatures:none;font-kerning:none;text-rendering:geometricPrecision;border:0;margin:0;outline:0}",
      ".hl{position:absolute;top:0;left:0;pointer-events:none;color:#d4d4d4;z-index:1;will-change:transform}",
      ".code{position:absolute;inset:0;color:transparent;-webkit-text-fill-color:transparent;caret-color:#fff;resize:none;background:transparent;z-index:2;overflow:auto}",
      ".code::selection{background:rgba(38,79,120,.99);color:transparent}",
      ".hl .kw{color:#569cd6}.hl .st{color:#ce9178}.hl .co{color:#6a9955}.hl .fn{color:#dcdcaa}.hl .nu{color:#b5cea8}",
      ".out{height:38%;border-top:1px solid #333;background:#181818;display:flex;flex-direction:column;flex:none}",
      ".out .head{height:24px;background:#252526;display:flex;align-items:center;padding:0 10px;font-size:10.5px;color:#969696;gap:10px;border-bottom:1px solid #333}",
      ".out .body{flex:1;overflow:auto;padding:6px 10px;font:12px/1.5 Consolas,'Courier New',monospace;color:#ccc;white-space:pre-wrap}",
      ".out .body .ln{display:flex;gap:6px}",
      ".out .body .ln.err{color:#f48771}",
      ".out .body .ln.ok{color:#4ec9b0}",
      ".out .body .ln.info{color:#569cd6}",
      ".preview-wrap{height:45%;border-top:1px solid #333;background:#fff;display:flex;flex-direction:column;flex:none;overflow:hidden}",
      ".preview-head{height:24px;background:#252526;display:flex;align-items:center;padding:0 10px;font-size:10.5px;color:#969696;gap:10px;border-bottom:1px solid #333;flex:none}",
      ".preview-body{flex:1;position:relative;overflow:hidden;background:#fff}",
      ".preview-iframe{width:100%;height:100%;border:0;background:#fff;display:block}",
      ".preview-stop{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(24,24,24,.94);color:#888;font:12px 'Segoe UI',sans-serif;gap:8px;text-align:center;padding:20px}",
      ".preview-stop .big{font-size:22px;color:#666}",
      ".status{height:20px;background:#0e639c;color:#fff;display:flex;align-items:center;padding:0 10px;font-size:10px;gap:12px;flex:none}",
      ".dlg-ov{position:absolute;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;z-index:100}",
      ".dlg{background:#2d2d2d;border:1px solid #444;padding:16px;width:360px;color:#ddd;font:12px 'Segoe UI',sans-serif}",
      ".dlg h3{font-size:13px;margin-bottom:10px}",
      ".dlg label{display:block;margin:8px 0 3px;font-size:11px;color:#aaa}",
      ".dlg input,.dlg select{width:100%;padding:5px 8px;background:#1e1e1e;border:1px solid #444;color:#fff;font:12px 'Segoe UI',sans-serif;outline:0}",
      ".dlg .row{display:flex;gap:6px;justify-content:flex-end;margin-top:12px}",
      ".dlg button{padding:4px 12px;background:#3a3a3a;color:#ddd;border:1px solid #444;cursor:pointer;font-size:11px}",
      ".dlg button.pr{background:#0e639c;color:#fff;border-color:#0e639c}",
      "</style></head><body>",
      "<div class='app'>",
      "<div class='top'>",
      "<button data-a='new'>+ New file</button>",
      "<button data-a='newproj'>New project</button>",
      "<button data-a='open'>Open</button>",
      "<select id='langsel'></select>",
      "<span style='flex:1'></span>",
      "<button data-a='live' class='live-btn on' id='live-btn'>Live</button>",
      "<button data-a='run' class='run'>Run</button>",
      "<button data-a='stop' class='stop'>Stop</button>",
      "<button data-a='clear' id='clear-btn'>Clear</button>",
      "</div>",
      "<div class='body'>",
      "<div class='side' id='side'></div>",
      "<div class='main'>",
      "<div class='tabs' id='tabs'></div>",
      "<div class='ed'><pre class='gt' id='gt'></pre><div class='wrap'><div class='hl' id='hl'></div><textarea class='code' id='code' wrap='off' spellcheck='false' autocorrect='off' autocapitalize='off' autocomplete='off'></textarea></div></div>",
      "<div class='out' id='console-wrap'><div class='head'><span id='st'>Ready</span><span style='margin-left:auto' id='prob'>0 problems</span></div><div class='body' id='out'></div></div>",
      "<div class='preview-wrap' id='preview-wrap' style='display:none'><div class='preview-head'><span>Preview</span><span style='margin-left:auto' id='preview-status'>Stopped</span><span style='opacity:.55'>auto-refresh</span></div><div class='preview-body' id='preview-body'></div></div>",
      "</div>",
      "</div>",
      "<div class='status'><span id='path'>-</span><span id='lang'>text</span><span id='cursor'>Ln 1, Col 1</span><span style='margin-left:auto' id='chars'>0 chars</span></div>",
      "</div>",
      "<script>",
      "(function(){",
      "var H=window.Hyflox,FS=H.fs,HOME=H.home;",
      "var WS=window.HYFLOX_PLUGIN_WORKSPACE||(HOME+'/Projects');",
      "var open=[],active=-1,outLines=[];",
      "var liveMode=true,previewRunning=false,liveTimer=null,previewIframe=null;",
      "var sel=document.getElementById('langsel'),code=document.getElementById('code'),hl=document.getElementById('hl'),gt=document.getElementById('gt'),tabs=document.getElementById('tabs'),side=document.getElementById('side'),out=document.getElementById('out'),statusEl=document.getElementById('st'),probEl=document.getElementById('prob'),pathEl=document.getElementById('path'),langEl=document.getElementById('lang'),charsEl=document.getElementById('chars'),cursorEl=document.getElementById('cursor');",
      "var consoleWrap=document.getElementById('console-wrap'),previewWrap=document.getElementById('preview-wrap'),previewBody=document.getElementById('preview-body'),previewStatus=document.getElementById('preview-status');",
      "var liveBtn=document.getElementById('live-btn'),clearBtn=document.getElementById('clear-btn'),stopBtn=document.querySelector('[data-a=stop]');",
      "var LANGS=[['','Auto'],['js','JavaScript'],['ts','TypeScript'],['py','Python'],['c','C'],['cpp','C++'],['go','Go'],['rs','Rust'],['html','HTML'],['css','CSS'],['json','JSON'],['md','Markdown'],['txt','Text']];",
      "sel.innerHTML=LANGS.map(function(p){return '<option value=\"'+p[0]+'\">'+p[1]+'</option>'}).join('');",
      "var KW={js:['const','let','var','function','return','if','else','for','while','class','new','this','import','export','async','await','try','catch','null','true','false','of','in','throw','typeof'],ts:['const','let','var','function','return','if','else','for','while','class','new','this','import','export','async','await','interface','type','enum','any','string','number','boolean','void','null','true','false'],py:['def','class','return','if','else','elif','for','while','import','from','try','except','finally','with','None','True','False','and','or','not','in','is','lambda','pass','self','raise'],c:['int','char','void','if','else','for','while','return','struct','const','static','sizeof','NULL','unsigned','signed','long','short'],cpp:['int','char','void','class','struct','public','private','protected','virtual','const','static','namespace','using','template','typename','new','delete','return','if','else','for','while','nullptr','true','false','auto'],go:['package','import','func','var','const','type','struct','interface','map','chan','go','defer','return','if','else','for','range','switch','case','nil','true','false'],rs:['fn','let','mut','const','struct','enum','trait','impl','pub','use','mod','match','if','else','for','while','loop','return','break','continue','self','Self','true','false','None','Some','Ok','Err']};",
      "function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}",
      "function ext(p){var n=p.split('/').pop(),i=n.lastIndexOf('.');return i<1?'':n.slice(i+1).toLowerCase()}",
      "function base(p){return p.split('/').pop()}",
      "function isHTML(){",
      "  if(active<0)return false;",
      "  var f=open[active];",
      "  var lang=sel.value||f.lang||ext(f.path);",
      "  return lang==='html'||lang==='htm';",
      "}",
      "function highlight(s,lang){",
      "  var kws=KW[lang];if(!kws)return esc(s);",
      "  var out='',i=0;",
      "  while(i<s.length){",
      "    var c=s[i];",
      "    if(c=='/'&&s[i+1]=='/'){var e=s.indexOf('\\n',i);if(e<0)e=s.length;out+='<span class=co>'+esc(s.slice(i,e))+'</span>';i=e;continue}",
      "    if(c=='/'&&s[i+1]=='*'){var e=s.indexOf('*/',i+2);if(e<0)e=s.length;out+='<span class=co>'+esc(s.slice(i,e+2))+'</span>';i=e+2;continue}",
      "    if(c=='#'&&(lang=='py'||lang=='sh')){var e=s.indexOf('\\n',i);if(e<0)e=s.length;out+='<span class=co>'+esc(s.slice(i,e))+'</span>';i=e;continue}",
      "    if(c=='\"'||c==\"'\"||c=='`'){var q=c,j=i+1;while(j<s.length&&s[j]!=q){if(s[j]=='\\\\')j++;j++}var chunk=s.slice(i,Math.min(j+1,s.length));out+='<span class=st>'+esc(chunk)+'</span>';i+=chunk.length;continue}",
      "    if(/[0-9]/.test(c)&&!/[A-Za-z_$]/.test(s[i-1]||'')){var j=i;while(j<s.length&&/[0-9._]/.test(s[j]))j++;out+='<span class=nu>'+esc(s.slice(i,j))+'</span>';i=j;continue}",
      "    if(/[A-Za-z_$]/.test(c)){var j=i;while(j<s.length&&/[A-Za-z0-9_$]/.test(s[j]))j++;var w=s.slice(i,j);if(kws.indexOf(w)>=0)out+='<span class=kw>'+esc(w)+'</span>';else if(s[j]=='(')out+='<span class=fn>'+esc(w)+'</span>';else out+=esc(w);i=j;continue}",
      "    out+=esc(c);i++;",
      "  }",
      "  return out;",
      "}",
      "function updateHL(){",
      "  var lang=sel.value||(active>=0?open[active].lang:'');",
      "  hl.innerHTML=highlight(code.value,lang)||'\\u00A0';",
      "}",
      "function updateGt(){",
      "  var lines=code.value.split('\\n').length;",
      "  var s='';for(var i=1;i<=lines;i++)s+=i+'\\n';",
      "  gt.textContent=s;",
      "  charsEl.textContent=code.value.length+' chars';",
      "}",
      "function updateCursor(){",
      "  var pos=code.selectionStart;",
      "  var before=code.value.slice(0,pos);",
      "  var line=before.split('\\n').length;",
      "  var col=pos-before.lastIndexOf('\\n');",
      "  cursorEl.textContent='Ln '+line+', Col '+col;",
      "}",
      "function updateLayout(){",
      "  var h=isHTML();",
      "  consoleWrap.style.display=h?'none':'flex';",
      "  previewWrap.style.display=h?'flex':'none';",
      "  liveBtn.style.display=h?'inline-block':'none';",
      "  stopBtn.style.display=h?'inline-block':'none';",
      "  clearBtn.style.display=h?'none':'inline-block';",
      "  if(h){",
      "    previewRunning=true;",
      "    refreshPreview();",
      "  }else{",
      "    if(previewIframe){previewIframe.remove();previewIframe=null;}",
      "  }",
      "}",
      "function refreshPreview(){",
      "  if(!isHTML())return;",
      "  if(!previewRunning)return;",
      "  if(active<0)return;",
      "  var f=open[active];",
      "  var ov=previewBody.querySelector('.preview-stop');",
      "  if(ov)ov.remove();",
      "  if(!previewIframe){",
      "    previewIframe=document.createElement('iframe');",
      "    previewIframe.className='preview-iframe';",
      "    previewIframe.setAttribute('sandbox','allow-scripts allow-forms allow-modals allow-popups');",
      "    previewIframe.setAttribute('referrerpolicy','no-referrer');",
      "    previewBody.appendChild(previewIframe);",
      "  }",
      "  previewIframe.srcdoc=f.code||'<!-- empty -->';",
      "  previewStatus.textContent=liveMode?'Live - Running':'Running';",
      "  statusEl.textContent='Live preview';",
      "}",
      "function stopPreview(){",
      "  previewRunning=false;",
      "  clearTimeout(liveTimer);",
      "  if(previewIframe){previewIframe.remove();previewIframe=null;}",
      "  previewStatus.textContent='Stopped';",
      "  statusEl.textContent='Stopped';",
      "  if(!previewBody.querySelector('.preview-stop')){",
      "    var ov=document.createElement('div');",
      "    ov.className='preview-stop';",
      "    ov.innerHTML='<div class=\"big\">Preview stopped</div><div>Click Run to refresh, or keep editing to auto-resume</div>';",
      "    previewBody.appendChild(ov);",
      "  }",
      "}",
      "function scheduleLiveRefresh(){",
      "  if(!liveMode)return;",
      "  if(!previewRunning)return;",
      "  if(!isHTML())return;",
      "  clearTimeout(liveTimer);",
      "  liveTimer=setTimeout(function(){",
      "    if(previewRunning)refreshPreview();",
      "  },350);",
      "}",
      "function render(){",
      "  tabs.innerHTML=open.length?open.map(function(f,i){return '<div class=\"tab'+(i==active?' on':'')+'\" data-i=\"'+i+'\">'+esc(base(f.path))+'<span class=x data-x=\"'+i+'\">x</span></div>'}).join(''):'<div style=\"padding:6px 12px;color:#777;font-size:11px\">No file open</div>';",
      "  tabs.querySelectorAll('.tab').forEach(function(t){t.onclick=function(e){if(e.target.dataset.x!=undefined){var x=+e.target.dataset.x;open.splice(x,1);if(active>=open.length)active=open.length-1;render();return}active=+t.dataset.i;render()}});",
      "  if(active>=0){var f=open[active];code.value=f.code;sel.value=f.lang||'';updateHL();pathEl.textContent=f.path;langEl.textContent=f.lang||ext(f.path)||'text'}else{code.value='';hl.innerHTML='';pathEl.textContent='-';langEl.textContent='text'}",
      "  updateGt();drawSide();updateLayout();",
      "}",
      "function drawSide(){",
      "  var items=FS.list(WS);",
      "  var html='<div class=grp>Workspace</div><div class=it style=\"font-weight:600\">'+esc(base(WS))+'</div><div style=\"padding-left:10px\">';",
      "  if(!items.length)html+='<div style=\"padding:4px;color:#777;font-size:10.5px\">Empty</div>';",
      "  else items.forEach(function(it){html+='<div class=it data-p=\"'+esc(it.path)+'\">'+(it.isDir?'[DIR]':it.icon)+' '+esc(it.name)+'</div>'});",
      "  html+='</div>';side.innerHTML=html;",
      "  side.querySelectorAll('.it[data-p]').forEach(function(x){x.onclick=function(){openFile(x.dataset.p)}});",
      "}",
      "function openFile(p){",
      "  if(FS.isDir(p))return;",
      "  var idx=open.findIndex(function(f){return f.path===p});",
      "  if(idx>=0){active=idx;render();return}",
      "  var c=FS.read(p);",
      "  if(c==null){H.notify('Cannot read '+base(p));return}",
      "  open.push({path:p,code:c,lang:''});",
      "  active=open.length-1;",
      "  render();",
      "}",
      "function writeOut(t,cls){",
      "  outLines.push({t:t,c:cls||''});",
      "  var d=document.createElement('div');",
      "  d.className='ln '+(cls||'');",
      "  d.textContent=t;",
      "  out.appendChild(d);out.scrollTop=out.scrollHeight;",
      "  var errs=outLines.filter(function(l){return l.c=='err'}).length;",
      "  probEl.textContent=errs+' problems';",
      "  statusEl.textContent=errs?'Errors':'Ready';",
      "}",
      "function clearOut(){outLines=[];out.innerHTML='';probEl.textContent='0 problems';statusEl.textContent='Ready'}",
      "async function run(){",
      "  if(active<0){if(!isHTML())writeOut('No file open','err');return}",
      "  var f=open[active];",
      "  var lang=sel.value||f.lang||ext(f.path);",
      "  if(lang==='html'||lang==='htm'){",
      "    previewRunning=true;",
      "    refreshPreview();",
      "    return;",
      "  }",
      "  clearOut();",
      "  writeOut('Running '+base(f.path)+' ('+lang+')','info');",
      "  if(lang==='js'||lang==='ts'){",
      "    var logs=0,errs=0;",
      "    var cs={",
      "      log:function(){var a=[].slice.call(arguments);logs++;writeOut(a.map(function(v){return typeof v=='object'?JSON.stringify(v,null,2):String(v)}).join(' '))},",
      "      info:function(){logs++;writeOut([].slice.call(arguments).map(String).join(' '),'info')},",
      "      warn:function(){logs++;writeOut('WARN '+[].slice.call(arguments).map(String).join(' '))},",
      "      error:function(){errs++;writeOut('ERROR '+[].slice.call(arguments).map(String).join(' '),'err')},",
      "      debug:function(){logs++;writeOut([].slice.call(arguments).map(String).join(' '))}",
      "    };",
      "    try{",
      "      var AF=Object.getPrototypeOf(async function(){}).constructor;",
      "      await new AF('console',f.code)(cs);",
      "    }catch(e){",
      "      errs++;",
      "      var m=(e.stack||'').match(/<anonymous>:(\\d+):(\\d+)/);",
      "      writeOut('ERROR '+e.name+': '+e.message+(m?' (line '+m[1]+', col '+m[2]+')':''),'err');",
      "    }",
      "    writeOut('-- '+logs+' logs, '+errs+' errors',errs?'err':'ok');",
      "    return;",
      "  }",
      "  if(lang==='py'){",
      "    writeOut('Loading Python runtime...','info');",
      "    try{",
      "      if(!window.loadPyodide)await new Promise(function(r,j){var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js';s.onload=r;s.onerror=j;document.head.appendChild(s)});",
      "      window._py=window._py||await loadPyodide({stdout:function(t){writeOut(t)},stderr:function(t){writeOut(t,'err')}});",
      "      await _py.runPythonAsync(f.code);",
      "      writeOut('-- finished','ok');",
      "    }catch(e){writeOut('ERROR '+(e.message||e),'err')}",
      "    return;",
      "  }",
      "  var errs=[];var pairs={'{':'}','[':']','(':')'};var stack=[];",
      "  for(var i=0;i<f.code.length;i++){",
      "    var c=f.code[i];",
      "    if('{[('.indexOf(c)>=0)stack.push(c);",
      "    else if('}])'.indexOf(c)>=0){var top=stack.pop();if(!top||pairs[top]!=c)errs.push('Unmatched '+c+' at '+i)}",
      "  }",
      "  stack.forEach(function(s){errs.push('Unclosed '+s)});",
      "  if(errs.length)errs.forEach(function(e){writeOut('ERROR '+e,'err')});",
      "  else writeOut('No syntax errors detected','ok');",
      "}",
      "code.addEventListener('input',function(){",
      "  if(active>=0)open[active].code=code.value;",
      "  updateHL();updateGt();updateCursor();",
      "  scheduleLiveRefresh();",
      "});",
      "code.addEventListener('scroll',function(){",
      "  gt.scrollTop=code.scrollTop;",
      "  hl.style.transform='translate(-'+code.scrollLeft+'px,-'+code.scrollTop+'px)';",
      "});",
      "code.addEventListener('keyup',updateCursor);",
      "code.addEventListener('click',updateCursor);",
      "code.addEventListener('select',updateCursor);",
      "code.addEventListener('keydown',function(e){",
      "  if(e.key=='Tab'){e.preventDefault();document.execCommand('insertText',false,'  ');return}",
      "  if(e.key=='Enter'&&e.ctrlKey){e.preventDefault();run()}",
      "  if(e.ctrlKey&&e.key.toLowerCase()=='s'){e.preventDefault();save()}",
      "  if(e.ctrlKey&&e.key.toLowerCase()=='a'){e.preventDefault();code.select()}",
      "});",
      "sel.onchange=function(){if(active>=0)open[active].lang=sel.value;updateHL();langEl.textContent=sel.value||(active>=0?ext(open[active].path):'text');updateLayout()};",
      "liveBtn.onclick=function(){",
      "  liveMode=!liveMode;",
      "  liveBtn.classList.toggle('on',liveMode);",
      "  liveBtn.textContent=liveMode?'Live':'Manual';",
      "  if(liveMode&&isHTML()){previewRunning=true;refreshPreview()}",
      "};",
      "function save(){",
      "  if(active<0){H.htaWarn('No file open','<div class=\"body\">Open or create a file first.</div>');return}",
      "  var f=open[active];",
      "  FS.write(f.path,f.code);",
      "  H.notify('Saved '+base(f.path));",
      "}",
      "document.querySelectorAll('[data-a]').forEach(function(b){",
      "  b.onclick=function(){",
      "    var a=b.dataset.a;",
      "    if(a=='new')newFile();",
      "    else if(a=='newproj')newProj();",
      "    else if(a=='open')openDlg();",
      "    else if(a=='run')run();",
      "    else if(a=='stop')stopPreview();",
      "    else if(a=='clear')clearOut();",
      "  };",
      "});",
      "function showDlg(title,build,ok){",
      "  var ov=document.createElement('div');ov.className='dlg-ov';",
      "  var d=document.createElement('div');d.className='dlg';",
      "  var h=document.createElement('h3');h.textContent=title;d.appendChild(h);",
      "  var b=document.createElement('div');build(b);d.appendChild(b);",
      "  var r=document.createElement('div');r.className='row';",
      "  var c=document.createElement('button');c.textContent='Cancel';c.onclick=function(){ov.remove()};",
      "  var o=document.createElement('button');o.className='pr';o.textContent='OK';",
      "  o.onclick=function(){if(ok()!==false)ov.remove()};",
      "  r.appendChild(c);r.appendChild(o);d.appendChild(r);",
      "  ov.appendChild(d);document.body.appendChild(ov);",
      "  var firstInput=d.querySelector('input');if(firstInput){setTimeout(function(){firstInput.focus();firstInput.select()},50)}",
      "}",
      "function newFile(){",
      "  showDlg('New file',function(b){",
      "    b.innerHTML='<label>File name</label><input id=\"n1\" placeholder=\"hello.html\"><label>Folder</label><input id=\"n2\" value=\"'+WS+'\"><label>Language</label><select id=\"n3\">'+LANGS.map(function(p){return '<option value=\"'+p[0]+'\">'+p[1]+'</option>'}).join('')+'</select>';",
      "  },function(){",
      "    var n=document.getElementById('n1').value.trim();",
      "    if(!n){H.htaWarn('Missing name','<div class=\"body\">Please enter a file name.</div>');return false}",
      "    var f=document.getElementById('n2').value.trim()||WS;",
      "    if(!FS.isDir(f)){H.htaWarn('Invalid folder','<div class=\"body\">The folder does not exist:<br><br><b>'+f.replace(/</g,'&lt;')+'</b></div>');return false}",
      "    var l=document.getElementById('n3').value||ext(n);",
      "    var p=FS.unique(f,n);",
      "    FS.write(p,starter(l,n));",
      "    openFile(p);drawSide();",
      "    H.notify('Created '+base(p));",
      "  });",
      "}",
      "function newProj(){",
      "  showDlg('New project',function(b){",
      "    b.innerHTML='<label>Project name</label><input id=\"n1\" value=\"MyProject\"><label>Location</label><input id=\"n2\" value=\"'+WS+'\">';",
      "  },function(){",
      "    var n=document.getElementById('n1').value.trim();",
      "    if(!n){H.htaWarn('Missing name','<div class=\"body\">Please enter a project name.</div>');return false}",
      "    var l=document.getElementById('n2').value.trim()||WS;",
      "    if(!FS.isDir(l)){H.htaWarn('Invalid location','<div class=\"body\">The folder does not exist:<br><br><b>'+l.replace(/</g,'&lt;')+'</b></div>');return false}",
      "    var d=FS.unique(l,n);",
      "    FS.mkdirp(d);FS.mkdirp(d+'/src');FS.mkdirp(d+'/assets');",
      "    WS=d;",
      "    H.notify('Project created at '+d);",
      "    drawSide();",
      "  });",
      "}",
      "function openDlg(){",
      "  showDlg('Open file',function(b){",
      "    b.innerHTML='<label>Path</label><input id=\"n1\" placeholder=\"'+WS+'/file.html\">';",
      "  },function(){",
      "    var p=document.getElementById('n1').value.trim();",
      "    if(!FS.exists(p)){H.htaWarn('File not found','<div class=\"body\">No file at:<br><br><b>'+p.replace(/</g,'&lt;')+'</b></div>');return false}",
      "    openFile(p);",
      "  });",
      "}",
      "function starter(l,n){",
      "  var T={js:'// '+n+'\\nconsole.log(\"Hello from CodingLite!\");\\n\\nconst nums = [1,2,3,4,5];\\nconsole.log(\"Sum:\", nums.reduce((a,b)=>a+b,0));\\n',ts:'// '+n+'\\nconst nums: number[] = [1,2,3];\\nconsole.log(nums);\\n',py:'# '+n+'\\nprint(\"Hello from CodingLite!\")\\nfor i in range(1,6):\\n    print(\"Count:\",i)\\n',c:'// '+n+'\\n#include <stdio.h>\\nint main(){\\n  printf(\"Hello\\\\n\");\\n  return 0;\\n}\\n',cpp:'// '+n+'\\n#include <iostream>\\nint main(){\\n  std::cout << \"Hello\" << std::endl;\\n  return 0;\\n}\\n',go:'// '+n+'\\npackage main\\nimport \"fmt\"\\nfunc main(){\\n  fmt.Println(\"Hello\")\\n}\\n',rs:'// '+n+'\\nfn main(){\\n  println!(\"Hello\");\\n}\\n',html:'<!DOCTYPE html>\\n<html>\\n<head>\\n<meta charset=\"utf-8\">\\n<title>'+n+'</title>\\n<style>\\nbody{font-family:system-ui,sans-serif;padding:40px;text-align:center;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;min-height:100vh;margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center}\\nh1{font-weight:200;letter-spacing:4px}\\nbutton{margin-top:20px;padding:10px 24px;border:0;border-radius:6px;background:#fff;color:#764ba2;font-size:14px;cursor:pointer;font-weight:600}\\n</style>\\n</head>\\n<body>\\n<h1>Hello, '+n+'</h1>\\n<p>Edit this file - the preview updates live.</p>\\n<button onclick=\"this.textContent=new Date().toLocaleTimeString()\">What time is it?</button>\\n</body>\\n</html>\\n',css:'/* '+n+' */\\nbody{font-family:sans-serif;background:#111;color:#eee;padding:40px}\\n',json:'{\\n  \"name\": \"'+n.replace(/\\.json$/,'')+'\",\\n  \"version\": \"1.0.0\"\\n}\\n',md:'# '+n+'\\n\\nHello.\\n',txt:''};",
      "  return T[l]||'';",
      "}",
      "var first=FS.list(WS).find(function(x){return !x.isDir});",
      "if(first)openFile(first.path);",
      "else{",
      "  var w=FS.unique(WS,'welcome.html');",
      "  FS.write(w,'<!DOCTYPE html>\\n<html>\\n<head>\\n<meta charset=\"utf-8\">\\n<title>Welcome</title>\\n<style>\\nbody{font-family:system-ui,sans-serif;background:linear-gradient(135deg,#0078d7,#4cc2ff);color:#fff;min-height:100vh;margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;text-align:center}\\nh1{font-weight:200;letter-spacing:6px;font-size:42px;margin-bottom:8px}\\np{opacity:.9;max-width:400px;line-height:1.6}\\nbutton{margin-top:24px;padding:12px 28px;border:0;border-radius:6px;background:#fff;color:#0078d7;font-size:14px;cursor:pointer;font-weight:600}\\n</style>\\n</head>\\n<body>\\n<h1>CODINGLITE</h1>\\n<p>Edit the HTML - the preview refreshes live on every keystroke.<br>Use <b>Stop</b> to pause, <b>Run</b> to resume, and <b>Live</b> to toggle auto-refresh.</p>\\n<button onclick=\"this.textContent=new Date().toLocaleTimeString()\">Click me</button>\\n</body>\\n</html>\\n');",
      "  openFile(w);",
      "}",
      "code.focus();",
      "})();",
      "<\/script></body></html>"
    ]
  }
]
